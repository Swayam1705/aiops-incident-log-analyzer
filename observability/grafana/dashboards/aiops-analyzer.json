{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "AIOps Incident & Log Analyzer",
  "uid": "aiops-analyzer",
  "tags": ["aiops", "incidents", "observability"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{app=~\"$app\"}[1m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error Rate (errors/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{outcome=\"error\",app=~\"$app\"}[1m]))",
          "legendFormat": "http 5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(app_errors_total{app=~\"$app\"}[1m])) by (error_type)",
          "legendFormat": "{{error_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request Latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{app=~\"$app\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=~\"$app\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{app=~\"$app\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Incidents Created (by severity)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(incidents_total{app=~\"$app\"}[1m])) by (severity)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Incidents (window)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(incidents_total{app=~\"$app\"}[$__range]))", "legendFormat": "incidents" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Analyzer Runs (incident / no-incident)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(analyzer_runs_total{app=~\"$app\"}[$__range])) by (outcome)", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Log Lines Collected vs Parsed vs Noise",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "analyzer_log_lines_collected{app=~\"$app\"}", "legendFormat": "collected" },
        { "refId": "B", "expr": "analyzer_log_lines_parsed{app=~\"$app\"}", "legendFormat": "parsed" },
        { "refId": "C", "expr": "analyzer_log_parse_errors{app=~\"$app\"}", "legendFormat": "noise" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Recent Incident Activity (LLM + notifications)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 22 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(llm_calls_total{app=~\"$app\"}[1m])) by (outcome)", "legendFormat": "llm {{outcome}}" },
        { "refId": "B", "expr": "sum(increase(notifications_total{app=~\"$app\"}[1m])) by (result)", "legendFormat": "notify {{result}}" },
        { "refId": "C", "expr": "sum(increase(incident_validations_total{app=~\"$app\"}[1m])) by (decision)", "legendFormat": "validation {{decision}}" }
      ]
    }
  ]
}
