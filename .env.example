# AIOps Incident & Log Analyzer - example environment.
# Copy to .env and adjust. Never commit .env (it is git-ignored).
# No paid API keys are required; the AI model runs locally through Ollama.

# --- service ---
APP_NAME=checkout-service
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=local

# --- logging / log collection ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
COLLECTOR_FILE_GLOB=logs/*.log

# --- bounded log window (most recent N lines analyzed) ---
LOG_WINDOW_SIZE=2000

# --- incident thresholds / triggers ---
ANALYZE_MIN_ERROR_LINES=5
# 0 disables scheduled analysis (manual/triggered only). Set e.g. 30 to auto-analyze.
ANALYZE_INTERVAL_SECONDS=0

# --- Ollama (local model). Pick a model that fits your machine's RAM. ---
# Laptop-friendly: qwen2.5:1.5b (~1.5GB) or llama3.2:1b (~1.3GB).
# Set OLLAMA_MODEL= (empty) to disable the LLM stage; rule-based analysis still runs.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONTEXT_LINES=60

# --- notification (optional, free/local-friendly webhook). Leave empty to disable. ---
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_TIMEOUT_SECONDS=5

# --- persistence ---
INCIDENTS_DIR=incidents/generated
REPORT_RETENTION_LIMIT=200

# --- failure-injection simulator (demo workload) ---
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=1
SIMULATOR_LOGS_PER_TICK=2
FAULT_DURATION_SECONDS=20
# Optional: set >0 to make memory-pressure physically allocate RAM (capped). Default 0 = log-only.
MEMORY_PRESSURE_SIMULATE_MB=0
MEMORY_PRESSURE_MAX_MB=256

# --- optional admin token for /admin/* fault-injection routes. Empty = open (local dev). ---
ADMIN_TOKEN=
